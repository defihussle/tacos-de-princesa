# Security headers for the static pages, applied by Cloudflare Workers Assets.
# (/api/* responses are Worker-generated; their headers are set in
# worker/index.js. This file is config, not a served file.)
#
# CSP ships in Report-Only first: the browser reports violations without
# blocking, so we can watch a real sandbox order (Clover SDK + card iframes +
# the reCAPTCHA badge Clover injects) and the other pages, then enforce by
# renaming the header to Content-Security-Policy. Production Clover hosts can
# only be proven in Phase 5 on livetest (docs/go-live.md).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=15552000

# Order page: tight, but allows Clover (sandbox + production), the reCAPTCHA
# badge Clover injects (google/gstatic), Turnstile, and Google Fonts.
/order.html
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw=' https://checkout.sandbox.dev.clover.com https://checkout.clover.com https://challenges.cloudflare.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://www.google.com https://www.gstatic.com; frame-src https://checkout.sandbox.dev.clover.com https://checkout.clover.com https://challenges.cloudflare.com https://www.google.com; connect-src 'self' https://checkout.sandbox.dev.clover.com https://apisandbox.dev.clover.com https://scl-sandbox.dev.clover.com https://checkout.clover.com https://api.clover.com https://scl.clover.com https://challenges.cloudflare.com https://www.google.com

